{
  "name": "InkWeb — Vector Graphics Editor",
  "short_name": "InkWeb",
  "description": "A browser-based SVG vector graphics editor with an Inkscape-style interface.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#26292c",
  "theme_color": "#26292c",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "image/svg+xml": [".svg", ".svgz"] }
    }
  ]
}
